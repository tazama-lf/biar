# -----------------------
# General Configuration
# -----------------------
# NOTE: Replace SERVER_C_HOST and SERVER_B_HOST with your actual hostnames/IPs.
GH_TOKEN=your_github_token
SERVER_C_HOST=your_server_host
SERVER_B_HOST=your_server_host
TAZAMA_WAREHOUSE_HOST_PATH=/opt/Warehouse
APP_BASE_DIR=/app
OUT_DIR=/app/out
NUM_WORKERS=1
PUBLIC_API_URL=http://${SERVER_C_HOST}:8282
LOG_LEVEL=INFO

# -----------------------
# AWS CLI Configuration
# -----------------------
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=tazama
S3A_ENDPOINT=http://${SERVER_C_HOST}:9878
S3A_ACCESS_KEY=your_access_key
S3A_SECRET_KEY=your_secret_key

# -----------------------
# Spark Configuration
# -----------------------
SPARK_MASTER=local[3]
SPARK_LOCAL_DIR=/tmp/spark
SPARK_DRIVER_MEMORY=6g
SPARK_DRIVER_MEMORY_OVERHEAD=2g
SPARK_DRIVER_MAX_RESULT_SIZE=4g
SPARK_EXECUTOR_MEMORY=6g
SPARK_EXECUTOR_MEMORY_OVERHEAD=2g
SPARK_SQL_SHUFFLE_PARTITIONS=48
SPARK_DEFAULT_PARALLELISM=48
SPARK_EXECUTOR_CORES=2
SPARK_DRIVER_CORES=2
SPARK_MEMORY_FRACTION=0.6
SPARK_MEMORY_STORAGE_FRACTION=0.3
HUDI_PARQUET_MAX_FILE_SIZE=134217728
HUDI_PARQUET_SMALL_FILE_LIMIT=104857600
HUDI_MEMORY_MERGE_FRACTION=0.2

# -----------------------
# Query API Spark Configuration
# -----------------------
QUERY_API_SPARK_MASTER=local[2]
QUERY_API_SPARK_DRIVER_MEMORY=2g
QUERY_API_SPARK_DRIVER_MEMORY_OVERHEAD=1g
QUERY_API_SPARK_EXECUTOR_MEMORY=2g
QUERY_API_SPARK_EXECUTOR_MEMORY_OVERHEAD=1g
QUERY_API_SPARK_SQL_SHUFFLE_PARTITIONS=16
QUERY_API_SPARK_DEFAULT_PARALLELISM=16
QUERY_API_SPARK_NETWORK_TIMEOUT=300s
QUERY_API_SPARK_HEARTBEAT_INTERVAL=60s
QUERY_API_SPARK_ADVISORY_PARTITION_SIZE=32mb
QUERY_API_SPARK_MAX_PARTITION_BYTES=32mb

# -----------------------
# Tika and Solr Configuration
# -----------------------
TIKA_PORT=9998
SOLR_PORT=8983
TIKA_URL=http://${SERVER_C_HOST}:9998

# -----------------------
# Nifi Configuration
# -----------------------
PB_CONTEXT_NAME=Parameters
PB_NAME=pbucket
PB_BUCKET=tazama
PB_SENSITIVE_FALSE=false
PB_HTTP_VALUE=http://${SERVER_C_HOST}:7619/checksubmit
PB_HTTP_NAME=phttp
# For fully-internal Docker Compose deployments NiFi can reach S3G directly via
# the Docker service name. Use http://s3g:9878 to avoid routing through the host
# network stack (which adds latency and risks transient NoHttpResponseException).
PB_OZONE_ENDPOINT=http://${SERVER_C_HOST}:9878
PB_OZONE_NAME=pozone
IMPORT_NIFI_TEMPLATE=true
NIFI_TEMPLATE_FILE=/nifi/tazama.xml
NIFI_TEMPLATE_TARGET_PG_ID=
NIFI_TEMPLATE_X=0.0
NIFI_TEMPLATE_Y=0.0
NIFI_PORT=8088
NIFI_WEB_HTTP_PORT=8088
NIFI_WEB_HTTP_HOST=0.0.0.0

# -----------------------
# JupyterHub Configuration
# -----------------------
JUPYTERHUB_PORT=8888
JUPYTERHUB_ADMIN=admin

# -----------------------
# Unstructured-Pipeline Configuration
# -----------------------F
NODE_ENV=dev
FUNCTION_NAME=biar-processor
COUCHDB_URL=http://username:password@${SERVER_B_HOST}:5984/cms-evidence
TIKA_URL=http://${SERVER_C_HOST}:9998
SOLR_URL=http://${SERVER_C_HOST}:8983/solr/biar_docs
NIFI_URL=http://${SERVER_C_HOST}:8081
CRON_ENABLED=true
CRON_SCHEDULE=*/30 * * * * *
MAX_FILE_SIZE_MB=50
MAX_SOLR_CONTENT=1000000
TIKA_TIMEOUT=30000
NIFI_TIMEOUT=30000