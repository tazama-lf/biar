# Environment Variables for Tazama Docker Setup
#
# Copy this file to .env and adjust values as needed
# docker-compose will automatically read .env file

# Spark Configuration
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MAXRESULTSIZE=2g

# JupyterHub Configuration
JUPYTERHUB_PORT=8000
JUPYTERHUB_PASSWORD=test123

# FastAPI Ports
FASTAPI_ARIF_PORT=8001
FASTAPI_IZYANE_PORT=8002
FASTAPI_ASIM_PORT=8003

# Spark UI Ports
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081

# Resource Limits (Docker)
CONTAINER_MEMORY_LIMIT=8G
CONTAINER_CPU_LIMIT=4

# Hudi/Data Configuration
# Warehouse path inside container (mounted from ./hudi_warehouse on host)
WAREHOUSE_ROOT=/app/Tazama_Hudi_warehouse
# OZONE_S3_ENDPOINT=http://localhost:9878
# OZONE_S3_ACCESS_KEY=admin
# OZONE_S3_SECRET_KEY=admin

# Logging
LOG_LEVEL=INFO

# AWS CLI Configuration

AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=tazama
S3A_ENDPOINT=http://${SERVER_C_HOST}:9878
S3A_ACCESS_KEY=tazama
S3A_SECRET_KEY=tazama

# Automation Orchestrator Configuration
ORCHESTRATOR_PORT=7619
NUM_WORKERS=1
WAREHOUSE_ROOT=/app/Tazama_Hudi_warehouse
SPARK_MASTER=local[*]
SPARK_LOCAL_DIR=/tmp/spark
APP_BASE_DIR=/app
OUT_DIR=/app/out

# Datalakehouse API Configuration
DATALAKEHOUSE_API_PORT=8282
WAREHOUSE_ROOT=/opt/Tazama_Warehouse
SPARK_MASTER=local[*]
SPARK_LOCAL_DIR=/tmp/spark
PUBLIC_API_URL=http://${SERVER_C_HOST}:8282

# JupyterHub Configuration
WAREHOUSE_ROOT=/opt/Tazama_Hudi_warehouse
SPARK_DRIVER_MEMORY=4g
JUPYTERHUB_ADMIN=admin

# Nifi Configuration
PB_CONTEXT_NAME=Parameters
PB_NAME=pbucket
PB_BUCKET=tazama
PB_SENSITIVE_FALSE=false
PB_HTTP_VALUE=http://10.10.80.20:7619/checksubmit
PB_HTTP_NAME=phttp
PB_OZONE_ENDPOINT=http://10.10.80.19:9878
PB_OZONE_NAME=pozone
PB_CONTEXT_NAME=Parameters


IMPORT_NIFI_TEMPLATE=true
NIFI_TEMPLATE_FILE=/nifi/tazama.xml
NIFI_TEMPLATE_TARGET_PG_ID=
NIFI_TEMPLATE_X=0.0
NIFI_TEMPLATE_Y=0.0

NIFI_WEB_HTTP_PORT=8088
NIFI_WEB_HTTP_HOST=0.0.0.0